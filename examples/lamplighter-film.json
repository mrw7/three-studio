    "captions": [
      { "start": 0.5, "end": 4.5, "text": "雾里，街上没有一盏灯。" },
      { "start": 5.2, "end": 11.5, "text": "它抱紧胸口那颗灯，一直走。" },
      { "start": 12.2, "end": 19.5, "text": "灯柱高得不像话。" },
      { "start": 20.2, "end": 25.5, "text": "一层，一层，向上。" },
      { "start": 26.2, "end": 31.5, "text": "手滑了。" },
      { "start": 32.2, "end": 37.8, "text": "它又爬了上去，把灯拧进灯座。" },
      { "start": 38.4, "end": 41.8, "text": "第一盏灯醒了。" },
      { "start": 42.2, "end": 47.8, "text": "光沿着街道，一盏接一盏地传下去。" },
      { "start": 48.2, "end": 53.8, "text": "它胸口的光，灭了。" },
      { "start": 54.4, "end": 59.4, "text": "后来，暖光漫回来，落在它身上。" }
    ],
