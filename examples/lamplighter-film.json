    "captions": [
      {
        "start": 0.5,
        "end": 4.5,
        "text": "Fog. Not a single light on the street."
      },
      {
        "start": 5.2,
        "end": 11.5,
        "text": "It holds the bulb in its chest and keeps walking."
      },
      {
        "start": 12.2,
        "end": 19.5,
        "text": "The lamp post is impossibly tall."
      },
      {
        "start": 20.2,
        "end": 25.5,
        "text": "One rung. Another. Up."
      },
      {
        "start": 26.2,
        "end": 31.5,
        "text": "Its hand slips."
      },
      {
        "start": 32.2,
        "end": 37.8,
        "text": "It climbs again, and screws the bulb into the socket."
      },
      {
        "start": 38.4,
        "end": 41.8,
        "text": "The first lamp wakes."
      },
      {
        "start": 42.2,
        "end": 47.8,
        "text": "Light runs down the street, lamp after lamp after lamp."
      },
      {
        "start": 48.2,
        "end": 53.8,
        "text": "The light in its chest goes out."
      },
      {
        "start": 54.4,
        "end": 59.4,
        "text": "Then the warm glow comes back, and settles on it."
      }
